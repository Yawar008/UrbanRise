{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "backend:clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "backend:restore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "restore",
                "${workspaceFolder}/backend/backend.csproj"
            ],
            "problemMatcher": "$msCompile",
            "dependsOn": "backend:clean",
            "dependsOrder": "sequence"
        },
        {
            "label": "backend:build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/backend/backend.csproj",
                "--no-restore"
            ],
            "problemMatcher": "$msCompile",
            "dependsOn": "backend:restore",
            "dependsOrder": "sequence"
        },
        {
            "label": "backend:wait",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Write-Host 'Waiting for backend on https://localhost:7043 ...'; while (-not (Test-NetConnection -ComputerName localhost -Port 7043 -WarningAction SilentlyContinue).TcpTestSucceeded) { Start-Sleep -Seconds 1 }; Write-Host 'Backend is ready.'"
            ],
            "problemMatcher": []
        },
        {
            "label": "frontend:dev",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".*",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:.*http://localhost:5173/.*"
                }
            },
            "dependsOn": "backend:wait",
            "dependsOrder": "sequence"
        }
    ]
}
